# Django
SECRET_KEY=sumaq-spa-insecure-secret-key-development-2026-prod-ready
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# Base de Datos (Compatible con XAMPP, MySQL Workbench / Server y SQLite)
# ------------------------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=sumaq_spa
DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Opción A - XAMPP (por defecto): dejar vacío
DB_PASSWORD=

# Opción B - MySQL Workbench / MySQL Server standalone:
# Configura aquí tu contraseña local de MySQL (ej: root, admin, 1234, etc.)
# DB_PASSWORD=tu_contraseña

# Opción C - SQLite (sin necesidad de tener MySQL instalado):
# Descomenta la siguiente línea para usar SQLite:
# DB_ENGINE=sqlite

# ------------------------------------------------------------------------------
# CORS & JWT
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7
